# Reglages de la chasse "spirale" (recette des gagnants : spiral fit -> snap -> flatten -> rendu -> encre)
SCROLL=PHerc0358
VOLUME_ID=20250821151737
# Bande la plus nette du rouleau d'apres le Scan-Quality-Map atlas (bin z=9216, qualite 0.73)
Z0=9400
Z1=10400
# Sens de la spirale : catalogue z_direction_is_top_to_bottom=true, left_handed_coordinates=false -> differents -> ACW
SENSE=ACW
# 8000 pas suffisent (loss -96 %, Ahggggg) ; les gagnants faisaient 30000 sur une 4090
STEPS=8000
# Nombre d'enroulements traites (du milieu vers l'exterieur)
MAXW=12
# Modeles d'encre : reader-v3, argus-v3 (communaute) + ink9 (officiel scrollprize/ink_9um, telecharge tout seul)
MODELES="reader argus ink9"
# Travaux lourds dans WSL (disque Linux rapide) ; resultats sur le Bureau
FL=$HOME/fl
SDT_WORKERS=6
